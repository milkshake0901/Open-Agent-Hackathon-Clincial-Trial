  "cards": [
    {
      "dot": "emerald",
      "title": "Loops and bounds",
      "items": [
        "Critic: retryable findings retry Intake up to 3 times; Conflicts go to the patient, never retried",
        "Evaluator: uncited claims retry the Matcher up to 3 times, then become unknown and Doctor questions"
      ]
    },
    {
      "dot": "violet",
      "title": "World Model owns the timeline",
      "items": [
        "Fact = assert_fact, Profile version = snapshot, Verdict = relate patient→trial",
        "Each engine event is projected to Postgres in the same transaction; Zetaris reads those tables"
      ]
    },
    {
      "dot": "slate",
      "title": "Scaffold status",
      "items": [
        "Designed flow from signatures and pseudocode; bodies raise NotImplementedError",
        "Every step is traced (trace_event, llm_call) for the Why page; not drawn"
      ]
    }
  ]
