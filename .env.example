# Copy to .env and fill in. Never commit .env.

# Our Postgres (docker-compose.yml)
PG_DSN=postgresql://trialmatch:trialmatch@localhost:5433/trialmatch

# Zetaris (from your local Zetaris web UI → API key)
ZETARIS_REST_URL=http://localhost:8888/api/v1.0
ZETARIS_ORG_ID=1
ZETARIS_API_KEY=your-zetaris-api-key
ZETARIS_DATASOURCE=trialmatch

ZETARIS_ADMIN_PASSWORD=YOUR_PASSWORD
ZETARIS_ADMIN_EMAIL=your@zetaris.com
ZETARIS_ADMIN_ORG=YOUR_ORG_NAME

# Meterless Nightshift (from the Nightshift Console). Nightshift holds its own NVIDIA key for the lanes it serves.
# The NVIDIA key is not stored in this file.
# Document extraction reads NVIDIA_PARSE_API_KEY. Doppler: doppler run -- <command>
# That secret is only for Nemotron Parse (nvidia/nemotron-parse). It is not NVIDIA_BUILD_SECRET.
# NVIDIA_PARSE_API_KEY=
METERLESS_BASE_URL=http://127.0.0.1:8088/v1
METERLESS_RUNTIME_TOKEN=your-nightshift-runtime-token
METERLESS_APP_ID=trialmatch
# Plain text calls outside a lane. Lanes are pinned to Nemotron Ultra in config.py (see DEVELOPER.md for why);
# override with LANE_MODELS='{"deep": "..."}'. Lanes name a model, not a meterless/* mode such as fusion.
METERLESS_MODEL=nvidia/nemotron-3.5-lightning-30b-a3b
# Optional: send lanes straight to NVIDIA's API instead of Nightshift. Needs both; off by default (every lane on Nightshift).
# Lightning as the judge was 30x slower than Ultra (see DEVELOPER.md), so it is not the default.
# NVIDIA_API_KEY=nvapi-your-key
# DIRECT_LANES={"judge": "nvidia/nemotron-3.5-lightning-30b-a3b"}
# Privacy floor for media source jobs: local-only | edge-only | cloud-ok
MEDIA_PRIVACY=local-only
# Every pipeline step and model call, one JSON object per line, rotated by size (default data/logs/trialmatch.jsonl)
# LOG_FILE=data/logs/trialmatch.jsonl
