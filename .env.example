# Copy to .env and fill in. Never commit .env.

# Our Postgres (docker-compose.yml)
PG_DSN=postgresql://trialmatch:trialmatch@localhost:5433/trialmatch

# Zetaris (from your local Zetaris web UI → API key)
ZETARIS_REST_URL=http://localhost:8888/api/v1.0
ZETARIS_ORG_ID=1
ZETARIS_API_KEY=your-zetaris-api-key
ZETARIS_DATASOURCE=trialmatch

# Meterless Nightshift (from the Nightshift Console). The NVIDIA key goes in Nightshift, not here.
METERLESS_BASE_URL=http://127.0.0.1:8088/v1
METERLESS_RUNTIME_TOKEN=your-nightshift-runtime-token
METERLESS_APP_ID=trialmatch
